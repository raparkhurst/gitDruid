[Desktop Entry]
Type=Application
Name=gitDruid
GenericName=Git Client
Comment=See what changed, stage it a hunk at a time, and write the message
Exec=git-druid %f
Icon=gitdruid
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;vcs;version control;commit;diff;branch;
StartupWMClass=gitdruid
MimeType=inode/directory;
